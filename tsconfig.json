{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "jsx": "react-jsx", "esModuleInterop": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true,
